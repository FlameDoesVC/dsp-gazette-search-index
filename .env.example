# Copy to .env and fill in values. See compose.yml / compose.prod.yml for
# which of these each stack actually consumes.

# --- Django core ---
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
POSTGRES_DB=gazette_search
POSTGRES_USER=gazette_search
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
DATABASE_URL=
DATABASE_URL_DIRECT=
DJANGO_CONN_MAX_AGE=0
STREAM_DB_ALIAS=direct

# Production-only Postgres tuning (compose.prod.yml)
PG_SHARED_BUFFERS=1GB
PG_EFFECTIVE_CACHE_SIZE=2560MB
PG_WORK_MEM=8MB
PG_MAINTENANCE_WORK_MEM=256MB
PG_MAX_CONNECTIONS=30

# --- Enrichment (LLM providers) ---
ENRICH_PROVIDER=deepseek
ENRICH_MODEL=deepseek-v4-flash
ENRICH_MODEL_ESCALATION=deepseek-v4-pro
ENRICH_MODEL_LOCAL=qwen3.5:4b
ENRICH_LOCAL_NUM_CTX=4096
CATALOG_PROFILE_NUM_CTX=16384
ENRICH_CHARS_PER_TOKEN=2.8
ENRICH_NUM_PREDICT=1536
ENRICH_LOCAL_CONCURRENCY=2
ENRICH_CONCURRENCY=8
ENRICH_TIMEOUT=120
ENRICH_MAX_INPUT_CHARS=3500

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
GEMINI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Ollama (self-hosted, e.g. GPU box). Absent in dev compose by design.
OLLAMA_URL=
OLLAMA_MODEL=gemma3:12b

# --- Translation ---
TRANSLATE_CONCURRENCY=4
TRANSLATE_TIMEOUT=30
TRANSLATE_MIN_CHARS=3
SEARCH_TRANSLATE_QUERIES=1

# --- Transcription (scanned PDFs, Claude Batch API) ---
TRANSCRIBE_MODEL=claude-haiku-4-5
TRANSCRIBE_MAX_PAGES=10
TRANSCRIBE_MAX_CER=0.15

# --- Attachment extraction ---
ATTACHMENT_FETCH_DELAY=0.5
SCANNED_CHARS_PER_PAGE=200

# --- OCR ---
GOOGLE_VISION_API_KEY=
OCR_DPI=300
OCR_REPAIR_MODEL=alakxender/t5-dhivehi-typo-corrector-asr
OCR_ANCHOR_MIN=0.30
OCR_CACHE_ENABLED=1
OCR_CACHE_DIR=
OCR_CACHE_SIZE_BYTES=8589934592

# --- Gazette scraper ---
# Default is 2 when DJANGO_DEBUG=1, else 3500.
GAZETTE_MAX_INDEX_PAGES=3500
GAZETTE_STOP_AFTER_SEEN_PAGES=3

# --- Search ---
SEARCH_DV_INDEX_MODE=dual
SEARCH_LOGGING_ENABLED=1
SEARCH_LOG_SALT=

# --- Reports ---
REPORT_RATE_LIMIT=20
REPORT_RATE_WINDOW=3600

# --- Pension calculations ---
PENSION_RATE=0.07
PENSION_BASE=basic
DEFAULT_WORKING_DAYS=20

# --- Web (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Production only (compose.prod.yml) ---
SITE_ADDRESS=
ACME_EMAIL=
ADMIN_ALLOW_CIDR=127.0.0.1/32
API_WORKERS=3
